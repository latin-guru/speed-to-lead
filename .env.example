# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# SQLite by default; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./speed_to_lead.db

# Signs CSRF tokens. Required when ENVIRONMENT=prod. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Meta Lead Ads webhook
META_VERIFY_TOKEN=change-me
META_APP_SECRET=change-me

# Rate limits
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_CAPACITY=120
WEBHOOK_RATE_LIMIT_REFILL_PER_MINUTE=600
PHONE_DAILY_CAP=3
# Only enable behind a reverse proxy you control (uses the right-most X-Forwarded-For hop).
TRUST_FORWARDED_FOR=false

# AI scoring: mock (default, no network) | claude | grok
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=4
AI_MAX_ATTEMPTS=3
AI_TOTAL_BUDGET_SECONDS=8
AI_MIN_CONFIDENCE=0.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
XAI_API_KEY=
XAI_MODEL=grok-4

# Operator API (/admin/*, stage moves, tasks, lead detail): Bearer token. Unset -> 503.
ADMIN_TOKEN=change-me
# HMAC secret for the mock inbound SMS reply webhook (/webhooks/inbound/sms). Unset -> 503.
INBOUND_WEBHOOK_SECRET=change-me

# Job queue / worker (python -m app.worker)
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=60
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_CAP_SECONDS=900
WORKER_POLL_SECONDS=1

# Follow-ups. Senders are MOCKS: "sent" messages go to the outbox_messages table only.
# FOLLOWUP_SEQUENCE_PATH=path/to/sequence.yaml   (default: app/followups/default_sequence.yaml)
BUSINESS_TIMEZONE=America/New_York
# Sending window in the lead's local time (business timezone if the lead's is unknown).
# A lead that arrives outside it gets the after-hours acknowledgment when the window opens.
QUIET_HOURS_ENABLED=true
SEND_WINDOWS="mon-sat 09:00-20:00; sun 15:00-18:00"
# The instant SMS + email acknowledgment counts as one touch.
MAX_TOUCHES_PER_WEEK=3
MIN_TOUCH_GAP_HOURS=24
CALLBACK_MINUTES=15
# Kill switch: true pauses every automated send (jobs wait, nothing is dropped).
# It can also be flipped at runtime: POST /admin/kill-switch
SENDS_PAUSED=false
KILL_SWITCH_RECHECK_SECONDS=300

# Dashboard (/dashboard): log in with ADMIN_TOKEN; the session cookie lasts this long.
SESSION_TTL_HOURS=12

# Demo mode (python -m app.demo / make demo sets it): RESETS the SQLite database on start,
# seeds fake data and runs the worker + a lead simulator in the web process. SQLite only.
DEMO_MODE=false
# Shown on the demo login page; opens the dashboard only. Default: copperline-demo
# DEMO_TOKEN=
DEMO_SEED=4242
DEMO_LEADS=150
DEMO_INTERVAL_MIN_SECONDS=5
DEMO_INTERVAL_MAX_SECONDS=10
# DEMO_BASE_URL=http://127.0.0.1:8000   (default: http://127.0.0.1:$PORT)

# CRM sync: mock (in-memory, no network) | hubspot (skeleton; needs HUBSPOT_TOKEN) | none
CRM_PROVIDER=mock
HUBSPOT_TOKEN=

# docker-compose only
POSTGRES_PASSWORD=change-me
