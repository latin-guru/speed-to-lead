# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# SQLite by default; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./speed_to_lead.db

# Signs CSRF tokens. Required when ENVIRONMENT=prod. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Phone numbers and emails are encrypted at rest. Required when ENVIRONMENT=prod.
# FIELD_ENCRYPTION_KEY: Fernet keys, comma-separated, newest first (rotate: add a new key in
# front, run `python -m app.cli rotate-keys`, then remove the old one). Generate with:
#   python -m app.cli generate-key
FIELD_ENCRYPTION_KEY=
# HMAC key for the blind index used to look up encrypted values (32+ random characters).
# Empty in dev/test: a public development key is used and /readyz warns.
BLIND_INDEX_KEY=

# Meta Lead Ads webhook
META_VERIFY_TOKEN=change-me
META_APP_SECRET=change-me

# Rate limits
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_CAPACITY=120
WEBHOOK_RATE_LIMIT_REFILL_PER_MINUTE=600
PHONE_DAILY_CAP=3
# Only enable behind a reverse proxy you control (uses the right-most X-Forwarded-For hop).
TRUST_FORWARDED_FOR=false

# AI scoring: mock (default, no network) | claude | grok
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=4
AI_MAX_ATTEMPTS=3
AI_TOTAL_BUDGET_SECONDS=8
AI_MIN_CONFIDENCE=0.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
XAI_API_KEY=
XAI_MODEL=grok-4

# Machine API (/admin/*, /api/leads/{id}, /api/tasks, /api/metrics) for scripts and
# integrations: Authorization: Bearer <ADMIN_TOKEN>. Unset -> 503. People use the
# dashboard with their own accounts (python -m app.cli create-user), not this token.
ADMIN_TOKEN=change-me
# HMAC secret for the mock inbound SMS reply webhook (/webhooks/inbound/sms). Unset -> 503.
INBOUND_WEBHOOK_SECRET=change-me

# Job queue / worker (python -m app.worker)
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=60
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_CAP_SECONDS=900
WORKER_POLL_SECONDS=1

# Follow-ups. Senders are MOCKS: "sent" messages go to the outbox_messages table only.
# FOLLOWUP_SEQUENCE_PATH=path/to/sequence.yaml   (default: app/followups/default_sequence.yaml)
BUSINESS_TIMEZONE=America/New_York
# Sending window in the lead's local time (business timezone if the lead's is unknown).
# A lead that arrives outside it gets the after-hours acknowledgment when the window opens.
QUIET_HOURS_ENABLED=true
SEND_WINDOWS="mon-sun 08:00-20:00"
# The instant SMS + email acknowledgment counts as one touch.
MAX_TOUCHES_PER_WEEK=3
MIN_TOUCH_GAP_HOURS=24
CALLBACK_MINUTES=15
# Kill switch: true pauses every automated send (jobs wait, nothing is dropped).
# It can also be flipped at runtime: POST /admin/kill-switch
SENDS_PAUSED=false
KILL_SWITCH_RECHECK_SECONDS=300

# Dashboard (/dashboard): email + password accounts with roles (admin | rep | viewer).
# Create the first admin with: python -m app.cli create-user --email you@example.com --role admin
# Sessions end after SESSION_TTL_HOURS (absolute) or SESSION_IDLE_MINUTES without activity.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# Lockout: after LOGIN_MAX_FAILURES failed logins in a row the account locks for
# LOGIN_LOCKOUT_BASE_SECONDS, doubling per further failure, up to the max.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Two-factor (TOTP, any authenticator app): required for admins (they can only reach their
# account page until it is set up), optional for reps, not offered to viewers.
ADMIN_2FA_REQUIRED=true
TOTP_ISSUER=speed-to-lead

# Data retention: `python -m app.cli retention` (schedule it daily) removes personal data
# from leads older than RETENTION_DAYS. anonymize keeps the row for metrics; delete removes it.
RETENTION_DAYS=365
RETENTION_MODE=anonymize

# Browser security. CORS is off unless exact origins are listed (comma-separated), e.g.
# CORS_ALLOWED_ORIGINS=https://www.example.com  (no wildcards; credentials are never allowed)
CORS_ALLOWED_ORIGINS=
# Request bodies larger than this get 413.
MAX_REQUEST_BYTES=65536
# Strict-Transport-Security on HTTPS responses.
HSTS_ENABLED=true
# Swagger UI at /docs and the schema at /openapi.json.
API_DOCS_ENABLED=true

# Demo mode (python -m app.demo / make demo sets it): RESETS the SQLite database on start,
# seeds fake data and runs the worker + a lead simulator in the web process. SQLite only.
DEMO_MODE=false
# Demo accounts <role>@example.com are seeded for each role in DEMO_ROLES, all with
# DEMO_PASSWORD (default: copperline-demo), and shown on the login page. For a public
# deployment use DEMO_ROLES=viewer. User changes are turned off in demo mode. The demo admin
# has two-factor on with a public secret, and the code step shows its current code.
# DEMO_PASSWORD=
DEMO_ROLES=admin,rep,viewer
# Demo mode refuses a real AI provider unless this is true, and refuses CRM_MOCK=false.
DEMO_ALLOW_REAL_AI=false
DEMO_SEED=4242
DEMO_LEADS=150
DEMO_INTERVAL_MIN_SECONDS=5
DEMO_INTERVAL_MAX_SECONDS=10
# DEMO_BASE_URL=http://127.0.0.1:8000   (default: http://127.0.0.1:$PORT)

# CRM sync: hubspot | gohighlevel | salesforce | none. CRM_MOCK=true (default) uses that
# CRM's in-memory MOCK (no network). CRM_MOCK=false uses the real-API skeleton, which needs
# the credentials below. Outbound hosts are fixed by an allowlist.
CRM_PROVIDER=hubspot
CRM_MOCK=true
HUBSPOT_TOKEN=
# GoHighLevel (API v2, private integration token for one location)
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
# Pipeline stage ids for each of our stages:
# GHL_STAGE_IDS=new=<id>,qualified=<id>,contacted=<id>,won=<id>,lost=<id>
GHL_STAGE_IDS=
# Salesforce (REST; OAuth access token + My Domain URL, e.g. https://<name>.my.salesforce.com)
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_API_VERSION=v61.0

# Interview mode: invite-only links (/try/<token>, created at /dashboard/interview) where a
# visitor receives ONE real email. SMS is never real. Real email needs BOTH settings below;
# everything else (public form, API, webhooks, later follow-ups) always uses the mock sender.
# EMAIL_BACKEND: mock (default) | smtp | gmail_api (skeleton, not run against a live account)
EMAIL_BACKEND=mock
INTERVIEW_EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_FROM_NAME=Copperline Roofing & Solar (demo)
# SMTP with STARTTLS, e.g. smtp.gmail.com with an app password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Gmail API (skeleton): an OAuth client and the sender's refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Links expire after this many minutes and work once.
INVITE_TTL_MINUTES=120
# Real emails per rolling hour / day (over a cap the mock is used and the visitor is told).
INTERVIEW_EMAIL_MAX_PER_HOUR=10
INTERVIEW_EMAIL_MAX_PER_DAY=30
INTERVIEW_FORM_PER_IP_PER_HOUR=5
# Demo mode only: a private admin account for creating invites on a hosted demo (never shown
# on the login page). All three go together; the TOTP secret is base32 (e.g. from
# python -c "import pyotp; print(pyotp.random_base32())") and goes in your authenticator app.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_OWNER_TOTP_SECRET=

# docker-compose only
POSTGRES_PASSWORD=change-me
